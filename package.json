{
  "name": "meu-posto-mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.22.1 <23"
  },
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "guards": "node scripts/guards.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "~19.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint",
      "prettier --write"
    ],
    "*.{json,css,md,yml}": [
      "prettier --write"
    ]
  }
}
